{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [".dist"],
  "compilerOptions": {
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@styles": ["./src/styles/index.css"],
      "@controls": ["./src/components/controls/index.ts"],
      "@layout": ["./src/components/layout/index.ts"]
    }
  }
}
