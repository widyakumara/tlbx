---
import { PageMeta } from "@layout";
import "/src/styles/index.css";

const site = {
  name: "tlbx",
};

const props = Astro.props;
const title = props.title ? `${props.title} • ${site.name}` : site.name;
---

<html lang="en">
  <head>
    <PageMeta />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class:list={["page", props.type]}>
    <div class="navbar fixed top-0 w-full z-50">
      <div class="flex-1">
        <a class="btn btn-ghost text-xl">daisyUI</a>
      </div>
    </div>

    <div class="drawer drawer-end lg:drawer-open md:drawer-open">
      <input id="drawer-left" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content">
        <div class="drawer lg:drawer-open md:drawer-open">
          <input id="drawer-left" type="checkbox" class="drawer-toggle" />
          <div class="drawer-content">
            <pre>main</pre>
          </div>
          <div class="drawer-side">
            <pre>left</pre>
          </div>
        </div>
      </div>
      <div class="drawer-side">
        <pre>RIGHT</pre>
      </div>
    </div>
  </body>
</html>
