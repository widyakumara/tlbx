---
import { PageMeta } from "@layout";
import "/src/styles/index.css";

const site = {
  name: "tlbx",
};

const props = Astro.props;
const title = props.title ? `${props.title} • ${site.name}` : site.name;
---

<html lang="en">
  <head>
    <PageMeta />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class:list={["page", props.type]}>
    <!-- header -->
    <div id="head" class="navbar sticky top-0 w-full">
      <div class="navbar-start">
        <label
          for="drawer"
          class="btn btn-square btn-ghost drawer-button md:hidden">
          SBO
        </label>
        <pre>navbar left</pre>
      </div>
      <div class="navbar-center flex-1">
        <pre>navbar center</pre>
      </div>
      <div class="navbar-end">
        <pre>navbar right</pre>
      </div>
    </div>
    <!-- /header -->
    <div id="body" class="drawer md:drawer-open">
      <input type="checkbox" id="drawer" class="drawer-toggle" />
      <div class="drawer-content">
        <main>isi utama</main>
        <aside class="sticky top-0"></aside>
      </div>
      <div class="drawer-side">
        <label
          for="drawer"
          class="md:hidden drawer-overlay"
          aria-label="Close menu">SBC</label
        >
        <pre>this is sidebar</pre>
      </div>
    </div>
  </body>
</html>
