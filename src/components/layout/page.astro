---
import { PageHead, PageMenu, PageMeta, PageSide } from "@layout";
import "./index.css";

const site = {
  name: "tlbx",
};

const props = Astro.props;
const title = props.title ? `${props.title} • ${site.name}` : site.name;
---

<html lang="en">
  <head>
    <PageMeta />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class:list={["page", props.type]}>
    <div id="root">
      <PageHead site={site} />
      <div id="body">
        <div id="main">
          <slot />
        </div>
        <PageMenu />
        <PageSide />
      </div>
    </div>
  </body>
</html>
